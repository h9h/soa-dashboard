{
  "name": "soa-dashboard",
  "version": "1.0.0",
  "license": "MIT",
  "dependencies": {
    "@koa/cors": "3.4.1",
    "activedirectory2": "2.1.0",
    "adm-zip": "0.5.9",
    "axios": "1.0.0",
    "koa": "2.13.4",
    "koa-bodyparser": "4.3.0",
    "koa-router": "12.0.0",
    "ldapjs": "2.3.3",
    "moment": "2.29.4",
    "ramda": "0.28.0"
  },
  "scripts": {
    "setup": "node scripts/setup-config.js",
    "backup:config": "node scripts/backupConfig.js",
    "lint": "npx eslint backend-*/**/*.js scripts/**/*.js",
    "lint:fix": "npx eslint backend-*/**/*.js scripts/**/*.js --fix",
    "start:auth": "node backend-auth/server.js",
    "start:frontend": "cd frontend && npm run start",
    "start": "npm-run-all --parallel start:frontend start:auth --print-label",
    "ncc:server:auth": "ncc run backend-auth/server.js",
    "ncc:build": "ncc build backend-auth/server.js -o dist/auth",
    "build": "cd frontend && npm run build",
    "build:all": "npm run backup:config && npm run build && npm run ncc:build",
    "postbuild:all": "cpy ./dist/auth/index.js ./frontend/build --rename=auth.js",
    "release-it": "cd frontend && npm run release-it && git push --follow-tags",
    "build-auth": "npx ncc build backend-auth/server.js -o dist/auth",
    "postbuild-auth": "cpy ./dist/auth/index.js ./frontend/build --rename=auth.js --flat"
  },
  "devDependencies": {
    "@vercel/ncc": "0.34.0",
    "cpy-cli": "4.2.0",
    "eslint": "^8.57.0",
    "npm-run-all": "4.1.5"
  }
}
